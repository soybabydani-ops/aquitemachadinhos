8:T588,{"@context":"https://schema.org","@graph":[{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Procedimentos de segurança residencial durante alertas de vento em Natal?","acceptedAnswer":{"@type":"Answer","text":"Fixe objetos externos, feche janelas, use fitas em X nas vidraças, desconecte eletrônicos e mantenha kit de emergência. Monitore Defesa Civil e evite sair durante alertas fortes."}},{"@type":"Question","name":"Como se proteger durante alertas climáticos em Natal?","acceptedAnswer":{"@type":"Answer","text":"Mantenha um kit de emergência com lanterna, água, rádio e medicamentos. Feche portas e janelas. Evite áreas alagadas e árvores. Monitore apps oficiais e a Defesa Civil."}},{"@type":"Question","name":"O que fazer em caso de queda de energia durante tempestades em Natal?","acceptedAnswer":{"@type":"Answer","text":"Desligue aparelhos eletrônicos, use lanternas e pilhas, evite velas. Mantenha geladeira fechada. Contate a companhia de energia local após o alerta."}}]},{"@type":"NewsArticle","headline":"Utilidade Pública e Alertas em Natal","description":"Informações de segurança, clima e serviços públicos em Natal.","datePublished":"2026-08-14","author":{"@type":"Organization","name":"Aqui Tem Achadinhos"},"publisher":{"@type":"Organization","name":"Aqui Tem Achadinhos","logo":{"@type":"ImageObject","url":"https://www.aquitemachadinhos.com.br/icon-512.png"}}}]}2:["$","main",null,{"className":"min-h-screen bg-white","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$8"}}],["$","div",null,{"className":"max-w-5xl mx-auto px-4 py-8","children":[["$","header",null,{"className":"mb-8","children":[["$","h1",null,{"className":"text-4xl font-bold text-gray-900","children":["Natal"," - Utilidade Pública e Alertas"]}],["$","p",null,{"className":"text-lg text-gray-600 mt-2","children":"Segurança residencial, clima e serviços públicos"}]]}],["$","section",null,{"className":"prose max-w-none","children":[["$","