    {
      "source": "/blumenau",
      "destination": "/guia-blumenau",
      "permanent": false
    },
    {
      "source": "/oktoberfest",
      "destination": "/guia-blumenau",
      "permanent": false
    },
    {
      "source": "/bonito",
      "destination": "/guia-bonito",
      "permanent": false
